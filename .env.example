# Copy to .env.local and fill in. All values are optional — the site runs
# without them (leads log to the server console; the demo page shows the
# built-in lead form).

# --- Demo scheduler (choose one) -------------------------------------------
# Cal.com:   https://cal.com/your-handle/demo
# Calendly:  https://calendly.com/your-handle/demo
# Leave unset to use the built-in lead form on /demo.
NEXT_PUBLIC_SCHEDULER_URL=

# --- Lead delivery via Resend (https://resend.com) -------------------------
# Without RESEND_API_KEY, leads are logged server-side (nothing is lost).
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=hello@ringkept.com
LEAD_FROM_EMAIL=leads@ringkept.com
